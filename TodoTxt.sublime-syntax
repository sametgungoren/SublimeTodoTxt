%YAML 1.2
---
# See http://www.sublimetext.com/docs/3/syntax.html
name: Todo.txt
file_extensions:
  - todo.txt
  - done.txt
  - todotxt
scope: text.todotxt
variables:
  date: (?:[1-2]\d{3}[-/\\.](?:0?[1-9]|1[012])[-/\\.](?:0?[1-9]|[12]\d|3[01]))
  task_dates: (?:({{date}})\s+(?:({{date}})\s+)?)?
contexts:
  main:
    - include: comments
    - include: task_done
    - include: task_in_progress
    - include: task_locked
    - include: task_active
    - include: task_todo


  task_done:
    - match: ^\s*\+\s+{{task_dates}}
      comment: Todo done item
      scope: comment.line.todotxt
      captures:
        1: constant.numeric.todotxt.date
        2: constant.numeric.todotxt.date
      push:
        - meta_scope: comment.line.todotxt
        - include: inside_task
        - match: $\n?
          pop: true


  task_in_progress:
    - match: ^\s*-\s+{{task_dates}}
      comment: Todo in progress item
      captures:
        1: constant.numeric.todotxt.date
        2: constant.numeric.todotxt.date
      push:
        - meta_scope: entity.task.todotxt.in_progress
        - include: inside_task
        - match: $\n?
          pop: true


  task_locked:
    - match: ^\s*(\?)\s+{{task_dates}}
      comment: Todo locked item
      captures:
        1: entity.task.todotxt.locked.marker
        2: constant.numeric.todotxt.date
        3: constant.numeric.todotxt.date
      push:
        - meta_scope: entity.task.todotxt.locked
        - include: inside_task
        - match: $\n?
          pop: true


  task_active:
    - match: ^\s*(\*)\s+{{task_dates}}
      comment: Todo active (current focus) item
      captures:
        1: entity.task.todotxt.active.marker
        2: constant.numeric.todotxt.date
        3: constant.numeric.todotxt.date
      push:
        - meta_scope: entity.task.todotxt.active
        - include: inside_task
        - match: $\n?
          pop: true


  task_todo:
    - match: '^(?:\s*(?:(\([A-Z]\))\s+)?(?:({{date}})\s+)?)?'
      comment: Todo item open
      captures:
        1: invalid.deprecated.todotxt
        2: constant.language.todotxt.priority
      push:
        - meta_scope: entity.task.todotxt
        - include: inside_task
        - match: $\n?
          pop: true


  inside_task:
    - match: (?:\s|^|\G)(\@\S+)
      comment: Todo item context
      captures:
        1: entity.name.tag.todotxt.context

    - match: (?:\s|^|\G)(\+\S+)
      comment: Todo item project
      captures:
        1: string.quoted.double.todotxt.project

    - match: '\b(?i:WAIT)\b'
      comment: Todo WAIT command
      scope: keyword.other.todotxt.wait

    - match: (\s+[^\s:]+:[^\s:]+)+\s*$
      comment: Custom attributes
      scope: variable.annotation.todotxt.attribute

  comments:
    - match: //
      scope: punctuation.definition.comment.example-c
      push:
        - meta_scope: comment.line.double-slash.example-c
        - match: $\n?
          pop: true
